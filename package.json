{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:repository": "tsx scripts/security/check-tracked-files.ts",
    "check": "npm run check:repository && npm run lint && npm run typecheck && npm run format:check",
    "test": "vitest run && npm run test:algorithms",
    "test:e2e": "playwright test",
    "seo:validate": "tsx scripts/seo/validate-indexing.ts",
    "admin:validate-auth": "tsx scripts/admin/validate-auth.ts",
    "photo-graph:doctor": "tsx scripts/photo-graph/doctor.ts",
    "photo-graph:copy:r2": "tsx scripts/photo-graph/copy-media-to-r2.ts",
    "photo-graph:apply-schema": "tsx scripts/photo-graph/apply-supabase-schema.ts",
    "photo-graph:migrate": "tsx scripts/photo-graph/migrate-firebase-to-supabase.ts",
    "photo-graph:rename-storage": "tsx scripts/photo-graph/rename-photo-graph-storage.ts",
    "photo-graph:backfill-dimensions": "tsx scripts/photo-graph/backfill-supabase-dimensions.ts",
    "photo-graph:fix-cache-control": "tsx scripts/photo-graph/fix-cache-control.ts",
    "photo-graph:analyze": "tsx scripts/photo-graph/analyze-graph.ts",
    "photo-graph:validate-edge-generation": "tsx scripts/photo-graph/validate-edge-generation.ts",
    "photo-graph:validate-color-models": "tsx scripts/photo-graph/validate-color-models.ts",
    "photo-graph:extract-colors": "tsx scripts/photo-graph/extract-color-features.ts",
    "photo-graph:backfill-colors": "tsx scripts/photo-graph/extract-color-features.ts --persist",
    "photo-graph:benchmark-colors": "tsx scripts/photo-graph/benchmark-color-models.ts",
    "photo-graph:activate-ciede2000": "tsx scripts/photo-graph/activate-ciede2000.ts",
    "test:algorithms": "node --import tsx scripts/photo-graph/validate-color-models.ts && node --import tsx scripts/photo-graph/validate-edge-generation.ts",
    "photo-graph:annotate-benchmark": "node --import tsx scripts/photo-graph/annotate-benchmark-report.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.4.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "framer-motion": "^14.9.0",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "postcss": "^8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-force-graph-2d": "^1.29.2",
    "sharp": "0.35.5",
    "supabase": "^2.122.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "image-size": "^2.0.4",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "gaxios": "7.1.4"
  }
}
